# Supabase is the only database and identity provider. Store actual values in a secret manager.
ATM_ENVIRONMENT=shared
ATM_DATABASE_URL=postgresql+psycopg://atm_app.yxcysaudekjhtsqoqghd:REPLACE@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.pem
ATM_AUTH_PROVIDER=supabase
ATM_ISSUER=https://yxcysaudekjhtsqoqghd.supabase.co/auth/v1
ATM_AUDIENCE=authenticated
ATM_JWKS_URL=https://yxcysaudekjhtsqoqghd.supabase.co/auth/v1/.well-known/jwks.json
ATM_JWT_ALGORITHMS=["ES256","RS256"]
ATM_REQUIRE_MFA=true
ATM_MAX_TOKEN_SECONDS=900
ATM_BROWSER_ORIGIN=https://monitor.example.org
ATM_ALLOWED_HOSTS=["monitor.example.org"]
ATM_SCORING_MODE=disabled
